---
import GitHubIcon from "../assets/icons/GitHubIcon.astro";
import GmailIcon from "../assets/icons/GmailIcon.astro";
import InstagramIcon from "../assets/icons/InstagramIcon.astro";
import LinkedInIcon from "../assets/icons/LinkedInIcon.astro";
import YoutubeIcon from "../assets/icons/YoutubeIcon.astro";

const faqs = [
  {
    question: "¿FidePOS requiere conexión a internet para funcionar?",
    answer:
      "No. FidePOS funciona de manera 100% local. Solo necesitas internet si deseas recuperar tu contraseña y el envío de bienvenida por correo electrónico.",
  },
  {
    question: "¿Tengo que pagar una mensualidad?",
    answer:
      "No. FidePOS es un software gratuito. Tus datos y el software te pertenecen para siempre, sin cuotas escondidas.",
  },
  {
    question: "¿Dónde se guardan mis datos y qué tan seguros están?",
    answer:
      "Tus datos se guardan en una base de datos SQLite cifrada dentro de tu propia computadora. Tú tienes el control total de tus respaldos y privacidad.",
  },
  {
    question: "¿Es compatible con impresoras de tickets y escáneres?",
    answer: "Continua en desarrollo (No se ha puesto a prueba).",
  },
  {
    question: "¿Puedo migrar mis datos si cambio de computadora?",
    answer:
      "¡Claro! Solo necesitas copiar tu archivo de base de datos (.db) a la nueva instalación y todas tus ventas, productos y clientes aparecerán al instante.",
  },
];
---

<section id="faq" class="py-24 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-extrabold text-[#F57C00] mb-4 tracking-tight">
        Preguntas Frecuentes
      </h2>
      <p class="text-lg text-slate-600">
        ¿Tienes dudas sobre FidePOS? Aquí respondemos las más comunes.
      </p>
    </div>

    <div class="space-y-4">
      {
        faqs.map((faq) => (
          <details class="group border-b border-slate-200 pb-4">
            <summary class="flex justify-between items-center font-bold text-lg text-slate-800 cursor-pointer list-none py-4 hover:text-[#F57C00] transition-colors">
              <span>{faq.question}</span>
              <span class="transition-transform duration-300 group-open:rotate-45 text-slate-400">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-6 h-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 4v16m8-8H4"
                  />
                </svg>
              </span>
            </summary>
            <p class="text-slate-600 leading-relaxed pb-4 pr-12 transition-all">
              {faq.answer}
            </p>
          </details>
        ))
      }
    </div>

    <div
      class="mt-20 p-10 bg-[#F57C00]/15 rounded-[2.5rem] border border-slate-100 text-center"
    >
      <h3 class="text-slate-900 font-bold mb-8 text-xl">
        ¿Aún tienes dudas? Conecta con nosotros
      </h3>

      <div class="flex flex-wrap justify-center gap-6">
        <!-- GMAIL -->
        <a
          href="mailto:typira.oficial@gmail.com"
          class="group flex flex-col items-center gap-2"
          title="Enviar correo"
        >
          <div
            class="w-14 h-14 bg-white rounded-2xl shadow-sm border border-slate-200 flex items-center justify-center text-slate-600 group-hover:border-[#F57C00] group-hover:text-[#F57C00] group-hover:-translate-y-1 transition-all duration-300"
          >
            <GmailIcon class="w-6 h-6" />
          </div>
          <span
            class="text-[10px] font-bold text-slate-400 uppercase tracking-widest group-hover:text-slate-900 transition-colors"
            >Gmail</span
          >
        </a>

        <!-- LINKEDIN -->
        <a
          href="https://www.linkedin.com/in/eric-villeda-reyes-584856281/"
          target="_blank"
          class="group flex flex-col items-center gap-2"
          title="Perfil de Indeed"
        >
          <div
            class="w-14 h-14 bg-white rounded-2xl shadow-sm border border-slate-200 flex items-center justify-center text-slate-600 group-hover:border-[#21409a] group-hover:text-[#21409a] group-hover:-translate-y-1 transition-all duration-300"
          >
            <LinkedInIcon class="w-6 h-6" />
          </div>
          <span
            class="text-[10px] font-bold text-slate-400 uppercase tracking-widest group-hover:text-slate-900 transition-colors"
            >LinkedIn</span
          >
        </a>

        <!-- INSTAGRAM -->
        <a
          href="https://instagram.com/jared29x"
          target="_blank"
          class="group flex flex-col items-center gap-2"
          title="Síguenos en Instagram"
        >
          <div
            class="w-14 h-14 bg-white rounded-2xl shadow-sm border border-slate-200 flex items-center justify-center text-slate-600 group-hover:border-[#E1306C] group-hover:text-[#E1306C] group-hover:-translate-y-1 transition-all duration-300"
          >
            <InstagramIcon class="w-6 h-6" />
          </div>
          <span
            class="text-[10px] font-bold text-slate-400 uppercase tracking-widest group-hover:text-slate-900 transition-colors"
            >Instagram</span
          >
        </a>

        <!-- YOUTUBE -->
        <a
          href="https://www.youtube.com/channel/UCXU0WuPFnylQh3dEcDiWOdg"
          target="_blank"
          class="group flex flex-col items-center gap-2"
          title="Síguenos en Instagram"
        >
          <div
            class="w-14 h-14 bg-white rounded-2xl shadow-sm border border-slate-200 flex items-center justify-center text-slate-600 group-hover:border-[#E1306C] group-hover:text-[#E1306C] group-hover:-translate-y-1 transition-all duration-300"
          >
            <YoutubeIcon class="w-6 h-6" />
          </div>
          <span
            class="text-[10px] font-bold text-slate-400 uppercase tracking-widest group-hover:text-slate-900 transition-colors"
            >Youtube</span
          >
        </a>

        <!-- GITHUB -->
        <a
          href="https://github.com/EricV29"
          target="_blank"
          class="group flex flex-col items-center gap-2"
          title="Ver Repositorio"
        >
          <div
            class="w-14 h-14 bg-white rounded-2xl shadow-sm border border-slate-200 flex items-center justify-center text-slate-600 group-hover:border-slate-900 group-hover:text-slate-900 group-hover:-translate-y-1 transition-all duration-300"
          >
            <GitHubIcon class="w-6 h-6" />
          </div>
          <span
            class="text-[10px] font-bold text-slate-400 uppercase tracking-widest group-hover:text-slate-900 transition-colors"
            >Github</span
          >
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
